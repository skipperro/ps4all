# Latest Ubuntu LTS
FROM ghcr.io/selkies-project/selkies-egl-desktop:26.04

ARG DEBIAN_FRONTEND=noninteractive

ENV WINEPREFIX="/home/ubuntu/arcware-prefix"
ENV WINEDEBUG="-all"
ENV PROTONPATH="GE-Proton"

# Create desktop
RUN /etc/container-entrypoint.sh &

# Install all the required packages not included in base image
RUN sudo apt update
RUN sudo apt install -y software-properties-common wget
#RUN sudo dpkg --add-architecture i386
#RUN mkdir -pm755 /etc/apt/keyrings
#RUN sudo wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key
#RUN sudo wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/resolute/winehq-resolute.sources
RUN sudo apt update
RUN sudo apt-get install -y ca-certificates gnupg curl wget

# Install MangoHud with NVIDIA support
RUN wget https://github.com/flightlessmango/MangoHud/releases/download/v0.8.4/MangoHud-0.8.4.r0.g992103e.tar.gz

RUN mkdir -p /home/ubuntu/mangohud-upstream
RUN tar -xzf MangoHud-0.8.4.r0.g992103e.tar.gz \
    -C /home/ubuntu/mangohud-upstream --strip-components=1
RUN rm -f MangoHud-0.8.4.r0.g992103e.tar.gz
WORKDIR /home/ubuntu/mangohud-upstream

RUN ./mangohud-setup.sh install
WORKDIR /home/ubuntu
RUN rm -rf mangohud-upstream

# Install codecs
RUN echo ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true | sudo debconf-set-selections
RUN sudo apt-get install -y ubuntu-restricted-extras

# Install umu run and GE-proton
RUN wget \
  https://github.com/Open-Wine-Components/umu-launcher/releases/download/1.4.4/python3-umu-launcher_1.4.4-1_amd64_ubuntu-resolute.deb \
  -O /tmp/umu.deb

RUN sudo apt install -y /tmp/umu.deb
RUN rm -f /tmp/umu.deb

# Initialize wineprefix with GE-proton. Exit code 1 is expected since we are not running a game yet.
RUN umu-run "" || true

RUN sudo rm -rf /var/lib/apt/lists/*

# Cleanup
RUN sudo apt autoremove -y
